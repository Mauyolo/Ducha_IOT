# Configuración local del SMCDI. Copia este archivo como .env y ajusta lo necesario.

# --- Modo de trabajo ---
# 1 = demo sin hardware: el simulador genera telemetría cada segundo.
# 0 = ESP32 físico conectado por MQTT.
SIMULATION=1
SEED_DEMO=1

# --- Servidor web ---
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- MQTT (sólo necesario con el ESP32 físico) ---
# En la demo con simulador se deja en 0 para no depender de Mosquitto.
MQTT_ENABLED=0
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=0
MQTT_CA_CERT=
MQTT_TOPIC_ROOT=smcdi

# --- Cuenta administradora inicial (sólo laboratorio) ---
ADMIN_USER=admin.ucsm
ADMIN_PASSWORD=Admin2026!
ADMIN_NAME=Administrador UCSM

# --- Parámetros ---
TOKEN_TTL_HOURS=12
AI_REDUCTION_PCT=15
MIN_HISTORY_FOR_AI=3
